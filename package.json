{
  "name": "scopewright",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "pack:theme": "node scripts/pack-theme.mjs",
    "typecheck": "tsc --noEmit -p .",
    "catalog:check": "node scripts/check-catalog.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0"
  },
  "type": "module",
  "description": "Scope, estimate, and document proof-of-concept engagements.",
  "license": "Apache-2.0"
}
